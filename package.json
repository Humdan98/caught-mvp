{
  "name": "caught",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/search.test.ts tests/backup.test.ts tests/validation.test.ts tests/db-config.test.ts",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts && prisma migrate deploy && tsx prisma/seed.ts",
    "db:deploy": "tsx scripts/db-migrate.ts",
    "db:seed:if-empty": "tsx scripts/db-seed-if-empty.ts",
    "turso:migrate": "tsx scripts/db-migrate.ts --env .env.turso",
    "turso:seed": "tsx prisma/seed.ts --env .env.turso",
    "vercel-build": "prisma generate && tsx scripts/db-migrate.ts && tsx scripts/db-seed-if-empty.ts && next build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.74.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
