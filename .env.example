# ─── Local development ─────────────────────────────────────────────────────────
# Nothing is required locally: with no Turso variables set, the app uses this SQLite file.
DATABASE_URL="file:./prisma/dev.db"

# ─── Production: Turso (set these in Vercel → Settings → Environment Variables) ──
# To run migrations or the demo seed against Turso from your own machine, put these two
# in a file called .env.turso (it's gitignored) and use `npm run turso:migrate` / `turso:seed`.
# Never commit real values.
#
#   turso db show <db-name> --url        →  TURSO_DATABASE_URL  (libsql://<db-name>-<org>.turso.io)
#   turso db tokens create <db-name>     →  TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ─── Optional ───────────────────────────────────────────────────────────────────
# true (default): buy buttons open the sandbox checkout so the click → sale loop can be demoed.
# false: buy buttons redirect straight to the real TikTok Shop / Amazon / brand links.
CAUGHT_SANDBOX="true"

# On deploy, the demo account is created only if the database has no users yet.
# Set to "false" to never create it.
CAUGHT_SEED_DEMO="true"

# Absolute site URL for share images. On Vercel it defaults to the production domain.
APP_URL=""
